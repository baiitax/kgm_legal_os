{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "public",
  "installCommand": "npm ci --include=dev",
  "framework": null,
  "functions": {
    "api/**": {
      "memory": 1769,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/firm",
      "destination": "/firm/index.html"
    },
    {
      "source": "/firm/:path*",
      "destination": "/firm/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]?path=:path*"
    },
    {
      "source": "/((?!api(?:/|$)|firm(?:/|$)|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/firm/assets/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        },
        {
          "key": "x-frame-options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "referrer-policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "strict-transport-security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
