    "start": "npm run start --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "test": "vitest run",
    "test:security": "vitest run tests/security",
    "test:e2e": "vitest run tests/e2e"
  },
  "engines": {
    "node": ">=20.11"
  }
}
