{
  "name": "kgm-legal-os",
  "version": "1.0.0",
  "private": true,
  "description": "KGM LEGAL OS \u2014 Saudi Legal Practice Management Platform. Secure Arabic-first Client Portal.",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server",
