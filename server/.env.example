# ============================================================================
# KGM LEGAL OS · API SERVER
# ============================================================================
# Copy to server/.env and fill in. `.env` is gitignored; this file is not.
# This repository is PUBLIC — never commit real values here.
#
#   cp server/.env.example server/.env
# ============================================================================

NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# 'postgres' is forced in production regardless of this value.
DB_DRIVER=postgres

# MUST authenticate as `portal_api`, NOT as `postgres`.
#
# The Supabase dashboard offers a connection string whose user is `postgres` — a
# SUPERUSER. Superusers bypass Row Level Security entirely, so using it silently
# disables every policy in migrations 0004 and 0006 while the app appears to work
# perfectly. `server/src/db/role-guard.ts` refuses to boot on that string.
#
# Create the login first:  supabase/ops/create_api_login.sql
#
# Use the SESSION pooler (port 5432) or the direct host. NEVER port 6543: the
# transaction pooler multiplexes callers over one backend session, and the
# driver's per-request identity is session-scoped (set_config(..., is_local =>
# false)), so identity could leak between requests.
DATABASE_URL=postgresql://portal_api:REPLACE_ME@aws-0-us-east-1.pooler.supabase.com:5432/postgres
PG_POOL_MAX=10

# ---------------------------------------------------------------------------
# SECRETS — the server REFUSES TO START in production without these.
# Generate each with:  openssl rand -hex 32
# ---------------------------------------------------------------------------
# Master key for encrypting MFA secrets at rest (32 bytes hex).
KGM_MASTER_KEY=
# Pepper for stored password hashes, so a stolen table is not rainbow-table usable.
KGM_HASH_PEPPER=
# Signing key for short-lived storage URLs.
KGM_SIGNED_URL_SECRET=

# ---------------------------------------------------------------------------
# STORAGE — Supabase private buckets (§18)
# ---------------------------------------------------------------------------
# Required when STORAGE_DRIVER=supabase. Without them, uploads fail at runtime
# rather than at boot, so set both together or neither.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_DRIVER=supabase
SUPABASE_BUCKET_DOCUMENTS=client-documents
SUPABASE_BUCKET_UPLOADS=client-uploads
SUPABASE_BUCKET_FINANCIAL=financial-documents
SIGNED_URL_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# SESSIONS
# ---------------------------------------------------------------------------
# Both cookie sets are httpOnly and must be Secure in production.
SESSION_SECURE_COOKIE=true
FIRM_SESSION_SECURE_COOKIE=true
# The SPA and the API are same-origin through a proxy rewrite, so 'lax' is
# sufficient for the portal and 'strict' remains viable for the firm OS.
SESSION_SAME_SITE=lax
FIRM_SESSION_SAME_SITE=strict

# ---------------------------------------------------------------------------
# PROXY / EDGE
# ---------------------------------------------------------------------------
# Trust the proxy's X-Forwarded-For. Required for correct rate limiting and for
# audit IP attribution behind Vercel or any load balancer; leaving it off while
# behind a proxy makes every request appear to come from one address.
TRUST_PROXY=1

# Who may frame the app. Must NOT be left as a wildcard in production.
ALLOW_FRAME_ANCESTORS='self'

# Simulated outbound email in the demo. Wire to SES/Postmark/Resend for real use.
EMAIL_DRIVER=console
