{
  "name": "@kgm/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "KGM shared PRESENTATIONAL primitives. No API client, no auth context, no route table \u2014 see README for why.",
  "main": "src/index.ts",
  "types": "src/index.ts",
